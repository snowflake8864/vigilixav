#ifndef VIGILIXAV_VER_H
#define VIGILIXAV_VER_H

/**
 * @macro
 * Version number of the vigilixav package release
 */
#define VIGILIXAV_VERSION "@PACKAGE_VERSION@"

/**
 * @macro
 * Numerical representation of the version number of the vigilixav package
 * release. This is a 24 bit number with 8 bits for major number, 8 bits
 * for minor and 8 bits for patch. Version 1.2.3 becomes 0x010203.
 */
#define VIGILIXAV_VERSION_NUM @PACKAGE_VERSION_NUM@

/**
 * @macro
 * Version number of the vigilixav library release
 */
#define LIBVIGILIXAV_VERSION "@LIBVIGILIXAV_VERSION@"

/**
 * @macro
 * Numerical representation of the version number of the libvigilixav library
 * release. This is a 24 bit number with 8 bits for major number, 8 bits
 * for minor and 8 bits for patch. Version 1.2.3 becomes 0x010203.
 */
#define LIBVIGILIXAV_VERSION_NUM @LIBVIGILIXAV_VERSION_NUM@

/**
 * @macro
 * Version number of the freshvigilix library release
 */
#define LIBFRESHVIGILIX_VERSION "@LIBFRESHVIGILIX_VERSION@"

/**
 * @macro
 * Numerical representation of the version number of the libfreshvigilix library
 * release. This is a 24 bit number with 8 bits for major number, 8 bits
 * for minor and 8 bits for patch. Version 1.2.3 becomes 0x010203.
 */
#define LIBFRESHVIGILIX_VERSION_NUM @LIBFRESHVIGILIX_VERSION_NUM@

#endif /* VIGILIXAV_VER_H */
